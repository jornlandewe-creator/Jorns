//@version=6
// BTC Trendbot 4h (video-template, getest 2020-2026)
// Gebruik: open een BTCUSD of BTCEUR chart op 4 uur, plak dit in de Pine Editor, klik "Add to chart".
// Resultaten staan in de Strategy Tester onderaan. Werkt op een gratis TradingView-account.
strategy("BTC Trendbot 4h", overlay = true,
     initial_capital = 1000, currency = currency.NONE,
     default_qty_type = strategy.fixed,
     commission_type = strategy.commission.percent, commission_value = 0.15,   // 0.1% fee + 0.05% slippage
     pyramiding = 0, margin_long = 0, margin_short = 0)

// ---------------- instellingen
trendLen = input.int(200, "Trend EMA")
macdFast = input.int(12, "MACD snel")
adxMin   = input.float(20, "ADX minimum")
volF     = input.float(0.8, "ATR-filter (x eigen gemiddelde)")
useVol   = input.bool(true, "Volumefilter")
slMult   = input.float(2.0, "Stop loss (x ATR)")
riskPct  = input.float(2.0, "Risico per trade (%)")
lev      = input.float(1.0, "Hefboom (max positie x account)", minval = 1)
tp1Mult  = input.float(0.0, "Deelwinst bij x ATR (0 = uit)")
tp1Pct   = input.int(33, "Deelwinst: % van positie")

// ---------------- indicatoren
t      = ta.ema(close, trendLen)
up     = close > t and t > t[1]
[macdL, sigL, hist] = ta.macd(close, macdFast, macdFast * 2 + 2, 9)
[diP, diM, adx] = ta.dmi(14, 14)
a      = ta.atr(14)
volOk  = a / ta.ema(a, 50) > volF and (not useVol or volume > ta.ema(volume, 20))

cond   = up and hist > 0 and adx > adxMin and diP > diM and volOk
entry  = cond and not cond[1]
exitL  = close < t

// ---------------- orders
var float stopPx = na
var float tp1Px  = na
var bool  tp1Hit = false

if entry and strategy.position_size == 0
    dist     = slMult * a
    notional = math.min(strategy.equity * riskPct / 100 * lev / (dist / close), strategy.equity * lev)
    strategy.entry("Long", strategy.long, qty = notional / close)
    stopPx := close - dist
    tp1Px  := tp1Mult > 0 ? close + tp1Mult * a : na
    tp1Hit := false

if strategy.position_size > 0
    if tp1Mult > 0 and not tp1Hit and high >= tp1Px
        tp1Hit := true
        stopPx := math.max(stopPx, strategy.position_avg_price * 1.0025)   // stop naar break-even
    if tp1Mult > 0 and not tp1Hit
        strategy.exit("TP1", "Long", qty_percent = tp1Pct, limit = tp1Px, stop = stopPx)
    strategy.exit("SL", "Long", stop = stopPx)
    if exitL
        strategy.close("Long", comment = "Onder EMA")

// ---------------- tekenen
plot(t, "EMA trend", color = color.new(color.teal, 0), linewidth = 2)
plot(strategy.position_size > 0 ? stopPx : na, "Stop", color = color.red, style = plot.style_linebr)
plotshape(entry, "Signaal", shape.triangleup, location.belowbar, color.teal, size = size.small)
